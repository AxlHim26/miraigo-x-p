# Use your development machine's LAN IP when testing with Expo Go on a phone.
# For example, replace 192.168.1.10 with the IPv4 address on your Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
# Optional browser override. Align the browser and backend hostnames for refresh cookies.
EXPO_PUBLIC_WEB_API_BASE_URL=http://localhost:8080
# Trusted miraigo-fe origin for the study tools embedded on mobile.
EXPO_PUBLIC_FE_BASE_URL=http://192.168.1.10:3000
# Voice AI service used by pronunciation, shadowing and transcription on mobile.
EXPO_PUBLIC_VOICE_API_URL=http://192.168.1.10:8000
# MiraiGo Japanese AI Platform (speech-to-text, mora-level pronunciation scoring). When set it replaces
# the legacy voice service above on mobile; it accepts the same access token as the backend.
# Over USB with `adb reverse tcp:8090 tcp:8090` use http://localhost:8090.
EXPO_PUBLIC_AI_BASE_URL=
EXPO_PUBLIC_APP_ENV=development
# Open the app with a local preview user when backend local-session is enabled.
EXPO_PUBLIC_DEV_AUTO_LOGIN=false
# Seeded mobile preview. Use npm run start:demo to enable for one session.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PACKAGER_HOSTNAME=192.168.1.10
